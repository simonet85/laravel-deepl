{
    "name": "simonet85/laravel-deepl",
    "description": "Laravel package for DeepL translation: facade, cache, placeholder protection and an Artisan command that fills your lang/*.json files",
    "keywords": ["laravel", "deepl", "translation", "i18n", "localization"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Simonet",
            "email": "christian.85@live.fr"
        }
    ],
    "require": {
        "php": "^8.2",
        "deeplcom/deepl-php": "^1.10",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Simonet85\\LaravelDeepL\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simonet85\\LaravelDeepL\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simonet85\\LaravelDeepL\\DeepLServiceProvider"
            ],
            "aliases": {
                "DeepL": "Simonet85\\LaravelDeepL\\Facades\\DeepL"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
